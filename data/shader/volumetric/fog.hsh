struct Fog {
    vec4 albedo;
    float density;
    float heightFalloff;
    float height;
    float scatteringAnisotropy;
    float ambientFactor;
};

// The fog has one medium: the density is its extinction, constant below the fog height and falling off exponentially
// above it. The scattering is the albedo times the extinction, the froxels and the rays to the lights use the same extinction

float GetVolumetricFogDensity(Fog fog, vec3 worldPos) {

    worldPos.y -= fog.height;

    return clamp(exp(-fog.heightFalloff * worldPos.y), 0.0, 1.0);

}

// Integral of the density profile over the height relative to the fog height
float IntegrateVolumetricFogDensity(Fog fog, float height) {

    if (height <= 0.0 || fog.heightFalloff <= 0.0)
        return height;
    return (1.0 - exp(-fog.heightFalloff * height)) / fog.heightFalloff;

}

// Transmittance between two points
float ComputeVolumetricFog(Fog fog, vec3 viewPos, vec3 worldPos) {

    float startHeight = viewPos.y - fog.height;
    float endHeight = worldPos.y - fog.height;
    float heightDifference = endHeight - startHeight;

    // The mean density along the ray, the integral over the height divided by the height difference. Below a centimeter
    // the difference of the integrals loses its precision, the density hardly changes there
    float meanDensity = abs(heightDifference) > 0.01 ?
        (IntegrateVolumetricFogDensity(fog, endHeight) - IntegrateVolumetricFogDensity(fog, startHeight)) / heightDifference :
        GetVolumetricFogDensity(fog, viewPos);

    float opticalDepth = fog.density * meanDensity * distance(viewPos, worldPos);
    return exp(-opticalDepth);

}

// Henyey-Greenstein phase function https://www.astro.umd.edu/~jph/HG_note.pdf
float ComputeScattering(float scatteringAnisotropy, float lightDotView) {
    
    // Range [-1;1]
    float g = scatteringAnisotropy;
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * 3.14 * pow(1.0 + g2 - (2.0 * g) * lightDotView, 1.5));
    

    /*
    float g = scatteringAnisotropy;
    float k = 1.55*g - 0.55*g*g*g;
    float k2 = k * k;
    return (1.0 - k2) / (4.0 * 3.14 * pow(1.0 - k * lightDotView, 2.0)); 
    */

}
