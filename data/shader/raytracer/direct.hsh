#extension GL_EXT_nonuniform_qualifier : require

#include <lights.hsh>
#include <common.hsh>
#include <surface.hsh>
#include <../common/random.hsh>
#include <../common/light.hsh>

int GetLightCount() {
    return PushConstants.lightCount;
}

// Candidates of the light selection, scenes with more lights only weight these. The path tracer weights all of them
#ifndef LIGHT_CANDIDATE_COUNT
#define LIGHT_CANDIDATE_COUNT 8
#endif

// The approximated contribution of a light to the shading point
float GetLightWeight(Light light, Surface surface) {

    float weight = 1.0;
    if (light.type == uint(DIRECTIONAL_LIGHT)) {
        weight = light.brightness;
    }
    else if (light.type == uint(POINT_LIGHT)) {
        float lightDistance = distance(light.P, surface.P);

        weight = light.brightness * GetDistanceAttenuation(lightDistance, light.radius);
    }
    else if (light.type == uint(SPOT_LIGHT)) {
        vec3 pointToLight = light.P - surface.P;
        float lightDistance = length(pointToLight);

        vec3 L = pointToLight / lightDistance;
        float angleAttenuation = saturate(dot(light.N, -L) * light.angleScale + light.angleOffset);

        weight = light.brightness * sqr(angleAttenuation) * GetDistanceAttenuation(lightDistance, light.radius);
    }

    // The minimum weight keeps the variance of far lights bounded
    return clamp(weight, 0.0000001, 1000000000000.0);

}

// Selects one light by its weight with weighted reservoir sampling. With up to LIGHT_CANDIDATE_COUNT lights all are
// weighted, otherwise the first light (the sun, RayTracingHelper puts directional lights first) and uniform
// candidates of the others, each weighted by its weight over its chance to be drawn. The sum of these weights is an
// unbiased estimate of the total weight, which divides the weight of the selected light into its probability.
Light GetLight(Surface surface, float seed0, float seed1, out float lightPdf) {

    Light selectedLight;
    float selectedWeight = 1.0;
    float totalWeight = 0.0;

    int lightCount = PushConstants.lightCount;
    bool allLights = lightCount <= LIGHT_CANDIDATE_COUNT;
int candidateCount = allLights ? lightCount : LIGHT_CANDIDATE_COUNT;
    // The share of the other lights each uniform candidate stands for
    float candidateScale = allLights ? 1.0 : float(lightCount - 1) / float(LIGHT_CANDIDATE_COUNT - 1);

    for (int i = 0; i < candidateCount; i++) {
        int lightIdx = i;
        float scale = 1.0;
        if (!allLights && i > 0) {
            lightIdx = 1 + int(random(seed0, seed1) * float(lightCount - 1));
            scale = candidateScale;
        }

        Light light = UnpackLight(lights[lightIdx]);
        float weight = GetLightWeight(light, surface);
        totalWeight += weight * scale;

        if (random(seed0, seed1) * totalWeight < weight * scale) {
            selectedWeight = weight;
            selectedLight = light;
        }
    }

    lightPdf = selectedWeight / totalWeight * selectedLight.pdf;
    return selectedLight;

}

// Points the surface to the light, all lights are punctual
void SampleLight(Light light, inout Surface surface, out float solidAngle, out float dist) {

    solidAngle = 1.0;
    if (light.type == uint(DIRECTIONAL_LIGHT)) {
        surface.L = -light.N;
        dist = INF;
    }
    else if (light.type == uint(POINT_LIGHT)) {
        vec3 pointToLight = light.P - surface.P;
        dist = length(pointToLight);
        surface.L = pointToLight / dist;

        solidAngle = GetDistanceAttenuation(dist, light.radius);
    }
    else if (light.type == uint(SPOT_LIGHT)) {
        vec3 pointToLight = light.P - surface.P;
        dist = length(pointToLight);
        surface.L = pointToLight / dist;

        float angleAttenuation = saturate(dot(surface.L, -light.N) * light.angleScale + light.angleOffset);
        solidAngle = sqr(angleAttenuation) * GetDistanceAttenuation(dist, light.radius);
    }
    UpdateSurface(surface);

}