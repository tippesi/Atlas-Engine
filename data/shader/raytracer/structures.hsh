// About alignement in GLSL: 
// A structure has to be a mupltiple of the size of
// it's largest member, e.g. for a bunch of floats it's one byte
// Every vec3 gets rounded up to 16 bytes, which means the structure
// has to be a size of multiple of 16 bytes.

#define INVALID_RAY_ID -1

struct PackedRay {
    vec4 origin;
    vec4 direction;
    vec4 hit;
};

struct PackedRayPayload {
    vec4 data;
};

struct Ray {
    int ID;
    
    vec3 origin;
    vec3 direction;

    int hitID;
    float hitDistance;
    int hitInstanceID;

    int currentInstanceID;

    // Hardware ray tracing returns the hit point on the triangle and its object space normal
    vec2 hitBarycentrics;
    vec3 hitGeometryNormal;
};

struct RayPayload {
    vec3 radiance;
    vec3 throughput;
};

struct AABB {
    
    vec3 min;
    vec3 max;
    
};

// See GPUTriangle, the positions come from the acceleration structure or from the BVH triangles
struct PackedTriangle {

    // 10:10:10 normals, the tangent with the handedness of the bitangent in w
    uvec4 normalsTangent;
    // Half texture coordinates, the material index in the lower 16 bit and the opacity as a half in the upper
    uvec4 texCoordsMaterialOpacity;
    // RGBA8, w is unused
    uvec4 colors;

};

struct Triangle {
    
    vec3 v0;
    vec3 v1;
    vec3 v2;
    
    vec3 n0;
    vec3 n1;
    vec3 n2;
    
    vec3 t;
    vec3 bt;
    float handedness;

    vec2 uv0;
    vec2 uv1;
    vec2 uv2;

    vec4 color0;
    vec4 color1;
    vec4 color2;
    
    int materialIndex;
    float opacity;
    
};

struct TextureLevel  {
    int layer;
    
    int x;
    int y;
    
    int width;
    int height;

    int valid;
};

struct Texture {
    TextureLevel level0;
    TextureLevel level1;
    TextureLevel level2;
    TextureLevel level3;
    TextureLevel level4;
    
    int valid;
};

// See GPUPackedMaterial, GetRaytraceMaterial of buffers.hsh unpacks it
struct PackedRaytraceMaterial {
    uint baseColor;
    uint emissiveRedGreen;
    uint emissiveBlueThickness;
    uint opacityRoughnessMetalnessAo;
    uint reflectanceNormalScaleFlags;
    uint tiling;
    uint uvAnimation;
    uint textures[4];
    uint transmissionColor;
    uint idGraphHitGroup;
    uint graphParameterOffset;
    uint refractiveIndexAttenuationDistance;
    uint attenuationColor;
};

struct RaytraceMaterial {

    int ID;
        
    float baseR;
    float baseG;
    float baseB;
    
    float emissR;
    float emissG;
    float emissB;
    
    float opacity;
    
    float roughness;
    float metalness;
    float ao;

    float reflectance;
    
    float normalScale;

    float tiling;
    float terrainTiling;
        
    int invertUVs;
    int twoSided;
    int cullBackFaces;
    int useVertexColors;
    
    int baseColorTexture;
    int opacityTexture;
    int normalTexture;
    int roughnessTexture;
    int metalnessTexture;
    int aoTexture;
    int emissiveTexture;    
    int terrainNormalTexture;

    uint transmissionColor;

    // Hit group of a material graph in ray tracing pipelines, 0 without one
    uint graphHitGroup;
    uint graphParameterOffset;
    float uvAnimationX;
    float uvAnimationY;

    // A blend mode of common/material.hsh, rays pass through translucent surfaces except with TRANSLUCENT_HITS, shadow
    // rays are dimmed by their opacity
    uint blendMode;
    // Of the inside of refracting surfaces, 1 for the others
    float refractiveIndex;

    // Absorbed inside refracting surfaces, 0 doesn't absorb
    uint attenuationColor;
    float attenuationDistance;
    // Of two sided refracting surfaces, which are thin slabs, 0 for the others
    float thickness;

};

struct PackedLight {
    vec4 P;
    vec4 N;
    vec4 color;
    vec4 data;
};

struct Light {
    vec3 P;
    vec3 N;

    vec3 radiance;

    uint type;

    bool castShadow;

    float pdf;
    float radius;
    float angleScale;
    float angleOffset;
    float brightness;
};

struct Instance {
    mat3x4 inverseMatrix;

    int meshOffset;
    int materialOffset;
    
    int nextInstance;
    int mask;

    // Device addresses of the normals of a deformed instance and the indices of its mesh, see GetTriangle
    uvec2 deformedVertices;
    uvec2 meshIndices;
};

struct PackedBVHNode {
    vec4 data0;
    vec4 data1;
    vec4 data2;
    vec4 data3;
};

struct BVHNode {
    AABB leftAABB;
    AABB rightAABB;
    int leftPtr;
    int rightPtr;
};

struct PackedBVHTriangle {
    vec4 v0;
    vec4 v1;
    vec4 v2;
};
