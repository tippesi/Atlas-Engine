// Data exchanged between the surface of hits and the hit shader of a material graph, see graphHit.rchit. The surface
// writes the input into the payload, the hit shader overwrites it with the output, both packed into eight words

// Needs common/normalencode.hsh

struct MaterialGraphHit {
    uint data[8];
};

struct MaterialGraphHitInput {
    // Tangent, bitangent and normal in world space, the hit shader gets positions and transforms from the hit object
    mat3 tangentFrame;
    vec4 color;
    vec2 texCoord;
    float frontFacing;
    float textureLevel;
    uint parameterOffset;
};

uint PackGraphHitDirection(vec3 direction) {

    return packSnorm2x16(EncodeNormal(direction));

}

vec3 UnpackGraphHitDirection(uint packed) {

    return DecodeNormal(unpackSnorm2x16(packed));

}

MaterialGraphHit PackGraphHitInput(MaterialGraphHitInput hitInput) {

    vec3 normal = normalize(hitInput.tangentFrame[2]);
    vec3 tangent = normalize(hitInput.tangentFrame[0]);
    // The bitangent is rebuilt from the normal and the tangent, only its side is kept
    bool flipBitangent = dot(cross(normal, tangent), hitInput.tangentFrame[1]) < 0.0;

    MaterialGraphHit hit;
    hit.data[0] = PackGraphHitDirection(normal);
    hit.data[1] = PackGraphHitDirection(tangent);
    hit.data[2] = floatBitsToUint(hitInput.texCoord.x);
    hit.data[3] = floatBitsToUint(hitInput.texCoord.y);
    hit.data[4] = packUnorm4x8(hitInput.color);
    hit.data[5] = (packHalf2x16(vec2(hitInput.textureLevel, 0.0)) & 0xFFFFu) | (hitInput.frontFacing < 0.0 ? 1u << 16u : 0u) |
        (flipBitangent ? 1u << 17u : 0u);
    hit.data[6] = hitInput.parameterOffset;
    hit.data[7] = 0u;
    return hit;

}

MaterialGraphHitInput UnpackGraphHitInput(MaterialGraphHit hit) {

    MaterialGraphHitInput hitInput;
    vec3 normal = UnpackGraphHitDirection(hit.data[0]);
    vec3 tangent = UnpackGraphHitDirection(hit.data[1]);
    vec3 bitangent = cross(normal, tangent) * ((hit.data[5] & (1u << 17u)) != 0u ? -1.0 : 1.0);
    hitInput.tangentFrame = mat3(tangent, bitangent, normal);
    hitInput.texCoord = vec2(uintBitsToFloat(hit.data[2]), uintBitsToFloat(hit.data[3]));
    hitInput.color = unpackUnorm4x8(hit.data[4]);
    hitInput.textureLevel = unpackHalf2x16(hit.data[5] & 0xFFFFu).x;
    hitInput.frontFacing = (hit.data[5] & (1u << 16u)) != 0u ? -1.0 : 1.0;
    hitInput.parameterOffset = hit.data[6];
    return hitInput;

}

// The values of the surface the hit shader evaluated
struct MaterialGraphHitOutput {
    vec3 baseColor;
    // In tangent space
    vec3 normal;
    vec3 emissive;
    float roughness;
    float metalness;
    float ao;
    float reflectance;
    // Amount of the base color passing thin surfaces
    float transmission;
    float refractiveIndex;
    float thickness;
    vec3 attenuationColor;
    float attenuationDistance;
    // Only evaluated for refracting surfaces, the any hit stage passes the others
    float opacity;
};

MaterialGraphHitOutput UnpackGraphHitOutput(MaterialGraphHit hit) {

    MaterialGraphHitOutput surface;
    vec4 baseColorTransmission = unpackUnorm4x8(hit.data[0]);
    surface.baseColor = baseColorTransmission.rgb;
    surface.transmission = baseColorTransmission.a;
    surface.normal = UnpackGraphHitDirection(hit.data[1]);
    vec2 emissiveRG = unpackHalf2x16(hit.data[2]);
    vec2 emissiveBRefraction = unpackHalf2x16(hit.data[3]);
    surface.emissive = vec3(emissiveRG, emissiveBRefraction.x);
    surface.refractiveIndex = emissiveBRefraction.y;
    vec4 roughnessMetalnessAoReflectance = unpackUnorm4x8(hit.data[4]);
    surface.roughness = roughnessMetalnessAoReflectance.x;
    surface.metalness = roughnessMetalnessAoReflectance.y;
    surface.ao = roughnessMetalnessAoReflectance.z;
    surface.reflectance = roughnessMetalnessAoReflectance.w;
    vec4 attenuationColorOpacity = unpackUnorm4x8(hit.data[6]);
    surface.attenuationColor = attenuationColorOpacity.rgb;
    surface.opacity = attenuationColorOpacity.a;
    vec2 thicknessAttenuation = unpackHalf2x16(hit.data[7]);
    surface.thickness = thicknessAttenuation.x;
    surface.attenuationDistance = thicknessAttenuation.y;
    return surface;

}
