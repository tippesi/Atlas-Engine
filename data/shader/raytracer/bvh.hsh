#extension GL_EXT_nonuniform_qualifier : require

#ifdef AE_HARDWARE_RAYTRACING
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_tracing_position_fetch : enable

layout(set = 2, binding = 23) uniform accelerationStructureEXT topLevelAS;
#endif

#include <common.hsh>
#include <intersections.hsh>
#include <structures.hsh>
#include <surface.hsh>
#include <buffers.hsh>

#ifdef AE_HARDWARE_RAYTRACING
// Object space normal of a triangle, the hit code transforms it with the instance
vec3 GetTriangleNormal(vec3 v0, vec3 v1, vec3 v2) {

    vec3 normal = cross(v0 - v1, v0 - v2);
    float len = length(normal);
    return len > 0.0 ? normal / len : vec3(0.0, 1.0, 0.0);

}
#endif

#define STACK_SIZE 32
#define TLAS_INVALID (STACK_SIZE + 2)

#ifndef AE_HARDWARE_RAYTRACING

BVHNode UnpackNode(PackedBVHNode compressed) {
    BVHNode node;

    node.leftAABB.min = vec3(compressed.data0.x,
    compressed.data0.y, compressed.data0.z);
    node.leftAABB.max = vec3(compressed.data0.w,
    compressed.data1.x, compressed.data1.y);
    node.rightAABB.min = vec3(compressed.data1.z,
    compressed.data1.w, compressed.data2.x);
    node.rightAABB.max = vec3(compressed.data2.y,
    compressed.data2.z, compressed.data2.w);

    node.leftPtr = floatBitsToInt(compressed.data3.x);
    node.rightPtr = floatBitsToInt(compressed.data3.y);

    return node;
}

// Use local stack if there isn't much register pressure. Note that the local stack is dynamically
// indexed and therefore might end up in (cached) device memory instead of registers.
// The shared stack is laid out with the thread index as the fastest changing index, such
// that all threads accessing the same stack depth hit different memory banks.
#ifndef LOCAL_STACK
shared int stack[STACK_SIZE][32];
#define STACK_ENTRY(idx) stack[idx][threadID]
#else
#define STACK_ENTRY(idx) stack[idx]
#endif

void CheckLeafClosest(inout Ray ray, int meshPtr, int nodePtr, float tmin, float tmax) {

    int triPtr = ~nodePtr;
    bool endOfNode = false;

    vec3 sol, v0, v1, v2, n;

    while (!endOfNode) {
        v0 = bvhTriangles[nonuniformEXT(meshPtr)].data[triPtr].v0.xyz;
        v1 = bvhTriangles[nonuniformEXT(meshPtr)].data[triPtr].v1.xyz;
        v2 = bvhTriangles[nonuniformEXT(meshPtr)].data[triPtr].v2.xyz;
        endOfNode = bvhTriangles[nonuniformEXT(meshPtr)].data[triPtr].v0.w > 0.0;
        float d = 0.0;
#ifdef BACKFACE_CULLING
        n = cross(v0 - v1, v0 - v2);
        d = dot(n, ray.direction);
#endif
        bool intersect = IntersectTriangle(ray, v0, v1, v2, sol);
        if (intersect && sol.x > tmin && sol.x < tmax && d <= 0.0) {
            if (sol.x < ray.hitDistance) {
                ray.hitDistance = sol.x;
                ray.hitID = triPtr;
                ray.hitInstanceID = ray.currentInstanceID;
            }
        }
        triPtr++;
    }

}

bool CheckLeaf(inout Ray ray, int meshPtr, int nodePtr, float tmin, float tmax) {

    int triPtr = ~nodePtr;
    bool endOfNode = false;

    vec3 sol, v0, v1, v2, n;
    bool hit = false;

    while (!endOfNode && !hit) {
        v0 = bvhTriangles[nonuniformEXT(meshPtr)].data[triPtr].v0.xyz;
        v1 = bvhTriangles[nonuniformEXT(meshPtr)].data[triPtr].v1.xyz;
        v2 = bvhTriangles[nonuniformEXT(meshPtr)].data[triPtr].v2.xyz;
        endOfNode = bvhTriangles[nonuniformEXT(meshPtr)].data[triPtr].v0.w > 0.0;
        float d = 0.0;
#ifdef BACKFACE_CULLING
        n = cross(v0 - v1, v0 - v2);
        d = dot(n, ray.direction);
#endif
        bool intersect = IntersectTriangle(ray, v0, v1, v2, sol);
        if (intersect && sol.x > tmin && sol.x < tmax && d <= 0.0) {
            hit = true;
            ray.hitDistance = sol.x;
            ray.hitID = triPtr;
            ray.hitInstanceID = ray.currentInstanceID;
        }
        triPtr++;
    }

    return hit;

}

void CheckLeafClosestTransparency(inout Ray ray, int meshPtr, int materialOffset,
int nodePtr, float tmin, float tmax) {

    int triPtr = ~nodePtr;
    bool endOfNode = false;

    vec3 sol, v0, v1, v2, n;

    while (!endOfNode) {
        Triangle tri = UnpackTriangle(triangles[nonuniformEXT(meshPtr)].data[triPtr]);
        v0 = tri.v0.xyz;
        v1 = tri.v1.xyz;
        v2 = tri.v2.xyz;
        endOfNode = tri.endOfNode;
        float d = 0.0;
 #ifdef BACKFACE_CULLING
        n = cross(v0 - v1, v0 - v2);
        d = dot(n, ray.direction);
#endif
        bool intersect = IntersectTriangle(ray, v0, v1, v2, sol);
        if (intersect && sol.x > tmin && sol.x < tmax && d <= 0.0 && sol.x < ray.hitDistance) {
            float opacity = tri.opacity < 0.0 ? GetOpacity(tri, sol.yz, materialOffset, 0) : tri.opacity;
            if (opacity > 0.0) {
                ray.hitDistance = sol.x;
                ray.hitID = triPtr;
                ray.hitInstanceID = ray.currentInstanceID;
            }
        }
        triPtr++;
    }

}

float CheckLeafTransparency(inout Ray ray, int meshPtr, int materialOffset, int nodePtr,
float tmin, float tmax, float transparency) {

    int triPtr = ~nodePtr;
    bool endOfNode = false;

    vec3 sol, v0, v1, v2, n;

    while (!endOfNode) {
        Triangle tri = UnpackTriangle(triangles[nonuniformEXT(meshPtr)].data[triPtr]);
        v0 = tri.v0.xyz;
        v1 = tri.v1.xyz;
        v2 = tri.v2.xyz;
        endOfNode = tri.endOfNode;
        float d = 0.0;
#ifdef BACKFACE_CULLING
        n = cross(v0 - v1, v0 - v2);
        d = dot(n, ray.direction);
#endif
        bool intersect = IntersectTriangle(ray, v0, v1, v2, sol);
        if (intersect && sol.x > tmin && sol.x < tmax && d <= 0.0) {
            ray.hitDistance = sol.x;
            ray.hitID = triPtr;
            ray.hitInstanceID = ray.currentInstanceID;
            transparency *= (1.0 - (tri.opacity < 0.0 ? GetOpacity(tri, sol.yz, materialOffset, 0) : tri.opacity));
        }
        triPtr++;
    }

    return transparency;

}

bool CheckInstance(inout Ray ray, inout uint cullMask, inout int meshPtr, inout int materialOffset, inout int nodePtr) {

    int instancePtr = ~nodePtr;
    Instance instance = bvhInstances[instancePtr]; 

    // Rejected instances must not transform the ray, the TLAS traversal continues with it
    if ((instance.mask & cullMask) == 0)
        return false;

    // We don't normalize the direction in case there is a scale in the
    // matrix. In that case the normalization leads to wrong scales in closest hit distance
    ray.origin = vec4(ray.origin, 1.0) * instance.inverseMatrix;
    ray.direction = vec4(ray.direction, 0.0) * instance.inverseMatrix;
    ray.currentInstanceID = instancePtr;

    meshPtr = instance.meshOffset;
    materialOffset = instance.materialOffset;
    nodePtr = 0;

    return true;

}

void HitClosest(inout Ray ray, uint cullMask, float tMin, float tMax) {

    uint stackPtr = 1u;
    int nodePtr = 0;
    int meshPtr = 0;
    int materialOffset = 0;
    uint threadID = gl_LocalInvocationIndex;

    vec3 originalRayOrigin = ray.origin;
    vec3 originalRayDirection = ray.direction;

    ray.hitDistance = tMax;

    if (isnan3(ray.direction))
        return;

#ifdef LOCAL_STACK
    int stack[STACK_SIZE];
#endif

    uint tlasIndex = TLAS_INVALID;

    // TLAS and BLAS nodes share one code path, only the node fetch differs. Lanes of a SIMD group
    // are often in different levels, separate paths would then be executed one after another.
    while (stackPtr != 0u) {
        bool isTlas = stackPtr < tlasIndex;
        if (isTlas && tlasIndex != TLAS_INVALID) {
            ray.origin = originalRayOrigin;
            ray.direction = originalRayDirection;
            tlasIndex = TLAS_INVALID;
        }

        if (nodePtr < 0) {
            if (isTlas) {
                if (CheckInstance(ray, cullMask, meshPtr, materialOffset, nodePtr))
                    tlasIndex = stackPtr;
                else
                    nodePtr = STACK_ENTRY(--stackPtr);
            }
            else {
                CheckLeafClosest(ray, meshPtr, nodePtr, tMin, ray.hitDistance);
                nodePtr = STACK_ENTRY(--stackPtr);
            }
        }
        else {
            PackedBVHNode packedNode;
            if (isTlas)
                packedNode = tlasNodes[nodePtr];
            else
                packedNode = blasNodes[nonuniformEXT(meshPtr)].data[nodePtr];
            BVHNode node = UnpackNode(packedNode);

            float hitL = 0.0, hitR = 0.0;
            bool intersectL = IntersectAABB(ray,
                node.leftAABB, tMin, ray.hitDistance, hitL);
            bool intersectR = IntersectAABB(ray,
                node.rightAABB, tMin, ray.hitDistance, hitR);

            bool noIntersection = !intersectL && !intersectR;
            nodePtr = hitL <= hitR ? node.leftPtr : node.rightPtr;
            nodePtr = noIntersection ? STACK_ENTRY(--stackPtr) : nodePtr;

            if (intersectR && intersectL) {
                int stackIdx = hitL <= hitR ? node.rightPtr : node.leftPtr;
                STACK_ENTRY(stackPtr++) = stackIdx;
            }
        }
    }

    ray.origin = originalRayOrigin;
    ray.direction = originalRayDirection;

}

void HitClosestTransparency(inout Ray ray, uint cullMask, float tMin, float tMax) {

    uint stackPtr = 1u;
    int nodePtr = 0;
    int meshPtr = 0;
    int materialOffset = 0;
    uint threadID = gl_LocalInvocationIndex;

    vec3 originalRayOrigin = ray.origin;
    vec3 originalRayDirection = ray.direction;

    ray.hitDistance = tMax;

    if (isnan3(ray.direction))
        return;

#ifdef LOCAL_STACK
    int stack[STACK_SIZE];
#endif

    uint tlasIndex = TLAS_INVALID;

    // See HitClosest for why TLAS and BLAS nodes share one code path
    while (stackPtr != 0u) {
        bool isTlas = stackPtr < tlasIndex;
        if (isTlas && tlasIndex != TLAS_INVALID) {
            ray.origin = originalRayOrigin;
            ray.direction = originalRayDirection;
            tlasIndex = TLAS_INVALID;
        }

        if (nodePtr < 0) {
            if (isTlas) {
                if (CheckInstance(ray, cullMask, meshPtr, materialOffset, nodePtr))
                    tlasIndex = stackPtr;
                else
                    nodePtr = STACK_ENTRY(--stackPtr);
            }
            else {
                CheckLeafClosestTransparency(ray, meshPtr, materialOffset, nodePtr, tMin, ray.hitDistance);
                nodePtr = STACK_ENTRY(--stackPtr);
            }
        }
        else {
            PackedBVHNode packedNode;
            if (isTlas)
                packedNode = tlasNodes[nodePtr];
            else
                packedNode = blasNodes[nonuniformEXT(meshPtr)].data[nodePtr];
            BVHNode node = UnpackNode(packedNode);

            float hitL = 0.0, hitR = 0.0;
            bool intersectL = IntersectAABB(ray,
                node.leftAABB, tMin, ray.hitDistance, hitL);
            bool intersectR = IntersectAABB(ray,
                node.rightAABB, tMin, ray.hitDistance, hitR);

            bool noIntersection = !intersectL && !intersectR;
            nodePtr = hitL <= hitR ? node.leftPtr : node.rightPtr;
            nodePtr = noIntersection ? STACK_ENTRY(--stackPtr) : nodePtr;

            if (intersectR && intersectL) {
                int stackIdx = hitL <= hitR ? node.rightPtr : node.leftPtr;
                STACK_ENTRY(stackPtr++) = stackIdx;
            }
        }
    }

    ray.origin = originalRayOrigin;
    ray.direction = originalRayDirection;

}

bool HitAny(inout Ray ray, uint cullMask, float tMin, float tMax) {

    if (isnan3(ray.direction))
        return false;

    bool hit = false;

    uint stackPtr = 1u;
    int nodePtr = 0;
    int meshPtr = 0;
    int materialOffset = 0;
    uint threadID = gl_LocalInvocationIndex;

    vec3 originalRayOrigin = ray.origin;
    vec3 originalRayDirection = ray.direction;

#ifdef LOCAL_STACK
    int stack[STACK_SIZE];
#endif

    uint tlasIndex = TLAS_INVALID;

    // See HitClosest for why TLAS and BLAS nodes share one code path
    while (stackPtr != 0u && !hit) {
        bool isTlas = stackPtr < tlasIndex;
        if (isTlas && tlasIndex != TLAS_INVALID) {
            ray.origin = originalRayOrigin;
            ray.direction = originalRayDirection;
            tlasIndex = TLAS_INVALID;
        }

        if (nodePtr < 0) {
            if (isTlas) {
                if (CheckInstance(ray, cullMask, meshPtr, materialOffset, nodePtr))
                    tlasIndex = stackPtr;
                else
                    nodePtr = STACK_ENTRY(--stackPtr);
            }
            else {
                if (CheckLeaf(ray, meshPtr, nodePtr, tMin, tMax)) {
                    hit = true;
                }
                nodePtr = STACK_ENTRY(--stackPtr);
            }
        }
        else {
            PackedBVHNode packedNode;
            if (isTlas)
                packedNode = tlasNodes[nodePtr];
            else
                packedNode = blasNodes[nonuniformEXT(meshPtr)].data[nodePtr];
            BVHNode node = UnpackNode(packedNode);

            bool intersectL = IntersectAABB(ray,
                node.leftAABB, tMin, tMax);
            bool intersectR = IntersectAABB(ray,
                node.rightAABB, tMin, tMax);

            nodePtr = intersectL ? node.leftPtr : node.rightPtr;
            nodePtr = !intersectR && !intersectL ? STACK_ENTRY(--stackPtr) : nodePtr;

            if (intersectR && intersectL) {
                STACK_ENTRY(stackPtr++) = node.rightPtr;
            }
        }
    }

    ray.origin = originalRayOrigin;
    ray.direction = originalRayDirection;

    return hit;

}

float HitAnyTransparency(inout Ray ray, uint cullMask, float tMin, float tMax) {

    if (isnan3(ray.direction))
        return 1.0;

    float transparency = 1.0;

    uint stackPtr = 1u;
    int nodePtr = 0;
    int meshPtr = 0;
    int materialOffset = 0;
    uint threadID = gl_LocalInvocationIndex;

    vec3 originalRayOrigin = ray.origin;
    vec3 originalRayDirection = ray.direction;

#ifdef LOCAL_STACK
    int stack[STACK_SIZE];
#endif

    uint tlasIndex = TLAS_INVALID;

    // See HitClosest for why TLAS and BLAS nodes share one code path
    while (stackPtr != 0u && transparency > 0.0) {
        bool isTlas = stackPtr < tlasIndex;
        if (isTlas && tlasIndex != TLAS_INVALID) {
            ray.origin = originalRayOrigin;
            ray.direction = originalRayDirection;
            tlasIndex = TLAS_INVALID;
        }

        if (nodePtr < 0) {
            if (isTlas) {
                if (CheckInstance(ray, cullMask, meshPtr, materialOffset, nodePtr))
                    tlasIndex = stackPtr;
                else
                    nodePtr = STACK_ENTRY(--stackPtr);
            }
            else {
                transparency *= CheckLeafTransparency(ray, meshPtr, materialOffset, nodePtr, tMin, tMax, transparency);
                if (transparency < 0.000001) {
                    transparency = 0.0;
                }
                nodePtr = STACK_ENTRY(--stackPtr);
            }
        }
        else {
            PackedBVHNode packedNode;
            if (isTlas)
                packedNode = tlasNodes[nodePtr];
            else
                packedNode = blasNodes[nonuniformEXT(meshPtr)].data[nodePtr];
            BVHNode node = UnpackNode(packedNode);

            bool intersectL = IntersectAABB(ray,
                node.leftAABB, tMin, tMax);
            bool intersectR = IntersectAABB(ray,
                node.rightAABB, tMin, tMax);

            nodePtr = intersectL ? node.leftPtr : node.rightPtr;
            nodePtr = !intersectR && !intersectL ? STACK_ENTRY(--stackPtr) : nodePtr;

            if (intersectR && intersectL) {
                STACK_ENTRY(stackPtr++) = node.rightPtr;
            }
        }
    }

    ray.origin = originalRayOrigin;
    ray.direction = originalRayDirection;

    return transparency;

}

#else

#ifdef RAY_TRACING_PIPELINE
// The hit object only identifies the hit, the ray generation stage shades it after the threads are reordered
layout(location = 0) rayPayloadEXT uvec2 unusedPayload;
layout(location = 0) hitObjectAttributeEXT vec2 hitObjectBarycentrics;

void TraceClosest(inout Ray ray, uint rayFlags, uint cullMask, float tMin, float tMax) {

    ray.hitDistance = tMax;

    // One hit record per geometry, the records of meshes with material graphs select their hit groups
    // (RayTracingWorld::hitRecords), reordering groups the threads by hit group first
    hitObjectTraceRayEXT(closestHitObject, topLevelAS, rayFlags, cullMask, 0, 1, 0,
        ray.origin, tMin, ray.direction, tMax, 0);

#ifdef SHADER_EXECUTION_REORDER
    // Hits on the same mesh share materials and textures, misses all sample the sky
    uint coherenceHint = hitObjectIsHitEXT(closestHitObject) ? uint(hitObjectGetInstanceCustomIndexEXT(closestHitObject)) + 1u : 0u;
    reorderThreadEXT(closestHitObject, coherenceHint, 16);
#endif

    if (hitObjectIsHitEXT(closestHitObject)) {
        hitObjectGetAttributesEXT(closestHitObject, 0);
        ray.hitBarycentrics = hitObjectBarycentrics;
#ifdef AE_POSITION_FETCH
        vec3 positions[3];
        hitObjectGetIntersectionTriangleVertexPositionsEXT(closestHitObject, positions);
        ray.hitGeometryNormal = GetTriangleNormal(positions[0], positions[1], positions[2]);
#endif

        ray.hitDistance = hitObjectGetRayTMaxEXT(closestHitObject);
        ray.hitInstanceID = hitObjectGetInstanceIdEXT(closestHitObject);

        int geometryOffset = hitObjectGetGeometryIndexEXT(closestHitObject);
        int meshIdx = hitObjectGetInstanceCustomIndexEXT(closestHitObject);

        int triangleOffset = int(geometryTriangleOffsets[nonuniformEXT(meshIdx)].data[nonuniformEXT(geometryOffset)]);
        ray.hitID = hitObjectGetPrimitiveIndexEXT(closestHitObject) + triangleOffset;
    }

}

void HitClosest(inout Ray ray, uint cullMask, float tMin, float tMax) {

    TraceClosest(ray, gl_RayFlagsOpaqueEXT, cullMask, tMin, tMax);

}

// Transparent geometry is resolved by the any hit stage
void HitClosestTransparency(inout Ray ray, uint cullMask, float tMin, float tMax) {

    TraceClosest(ray, gl_RayFlagsNoneEXT, cullMask, tMin, tMax);

}
#else
void SetCommittedHitGeometry(inout Ray ray, rayQueryEXT rayQuery) {

    ray.hitBarycentrics = rayQueryGetIntersectionBarycentricsEXT(rayQuery, true);
#ifdef AE_POSITION_FETCH
    vec3 positions[3];
    rayQueryGetIntersectionTriangleVertexPositionsEXT(rayQuery, true, positions);
    ray.hitGeometryNormal = GetTriangleNormal(positions[0], positions[1], positions[2]);
#endif

}

void HitClosest(inout Ray ray, uint cullMask, float tMin, float tMax) {

    ray.hitDistance = tMax;

    rayQueryEXT rayQuery;
    // Every candidate would be confirmed anyway, opaque rays keep the traversal in hardware
    rayQueryInitializeEXT(rayQuery, topLevelAS, gl_RayFlagsOpaqueEXT, cullMask,
        ray.origin, tMin, ray.direction, tMax);

    // Start traversal: return false if traversal is complete
    while(rayQueryProceedEXT(rayQuery)) {
        if (rayQueryGetIntersectionTypeEXT(rayQuery, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            rayQueryConfirmIntersectionEXT(rayQuery);
        }
    }

    // Returns type of committed (true) intersection
    if(rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        ray.hitDistance = rayQueryGetIntersectionTEXT(rayQuery, true);
        ray.hitInstanceID = rayQueryGetIntersectionInstanceIdEXT(rayQuery, true);

        int geometryOffset = rayQueryGetIntersectionGeometryIndexEXT(rayQuery, true);
        int meshIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);

        int triangleOffset = int(geometryTriangleOffsets[nonuniformEXT(meshIdx)].data[nonuniformEXT(geometryOffset)]);
        ray.hitID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true) + triangleOffset;

        SetCommittedHitGeometry(ray, rayQuery);
    }
}

#endif

bool HitAny(inout Ray ray, uint cullMask, float tMin, float tMax) {

    ray.hitDistance = tMax;

    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, topLevelAS, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, cullMask,
        ray.origin, tMin, ray.direction, tMax);

    // Start traversal: return false if traversal is complete
    while(rayQueryProceedEXT(rayQuery)) {
        if (rayQueryGetIntersectionTypeEXT(rayQuery, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            rayQueryConfirmIntersectionEXT(rayQuery);
        }
    }

    // Returns type of committed (true) intersection
    if(rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        return true;
    }

    return false;

}

#ifndef RAY_TRACING_PIPELINE
void HitClosestTransparency(inout Ray ray, uint cullMask, float tMin, float tMax) {

    ray.hitDistance = tMax;

    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, topLevelAS, gl_RayFlagsNoneEXT, cullMask,
        ray.origin, tMin, ray.direction, tMax);

    // Start traversal: return false if traversal is complete
    bool proceed = true;
    while(rayQueryProceedEXT(rayQuery)) {

        if (rayQueryGetIntersectionTypeEXT(rayQuery, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            int geometryOffset = rayQueryGetIntersectionGeometryIndexEXT(rayQuery, false);
            int meshIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, false);

            int triangleOffset = int(geometryTriangleOffsets[nonuniformEXT(meshIdx)].data[nonuniformEXT(geometryOffset)]);
            int hitID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, false) + triangleOffset;

            int hitInstanceID = rayQueryGetIntersectionInstanceIdEXT(rayQuery, false);
            int materialOffset = bvhInstances[hitInstanceID].materialOffset;

            vec2 barrycentric = rayQueryGetIntersectionBarycentricsEXT(rayQuery, false);

            Triangle tri = UnpackTriangle(triangles[nonuniformEXT(meshIdx)].data[nonuniformEXT(hitID)]);

            if (GetOpacity(tri, barrycentric, materialOffset, 0) > 0.001) {
                rayQueryConfirmIntersectionEXT(rayQuery);
            }

        }

    }

    if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        ray.hitDistance = rayQueryGetIntersectionTEXT(rayQuery, true);
        ray.hitInstanceID = rayQueryGetIntersectionInstanceIdEXT(rayQuery, true);

        int geometryOffset = rayQueryGetIntersectionGeometryIndexEXT(rayQuery, true);
        int meshIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);

        int triangleOffset = int(geometryTriangleOffsets[nonuniformEXT(meshIdx)].data[nonuniformEXT(geometryOffset)]);
        ray.hitID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true) + triangleOffset;

        SetCommittedHitGeometry(ray, rayQuery);
    }

}

#endif

float HitAnyTransparency(inout Ray ray, uint cullMask, float tMin, float tMax) {

    float transparency = 1.0;

    ray.hitDistance = tMax;

    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, topLevelAS, gl_RayFlagsTerminateOnFirstHitEXT, cullMask,
        ray.origin, tMin, ray.direction, tMax);

    while(rayQueryProceedEXT(rayQuery)) {

        if (rayQueryGetIntersectionTypeEXT(rayQuery, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            int geometryOffset = rayQueryGetIntersectionGeometryIndexEXT(rayQuery, false);
            int meshIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, false);

            int triangleOffset = int(geometryTriangleOffsets[nonuniformEXT(meshIdx)].data[nonuniformEXT(geometryOffset)]);
            int hitID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, false) + triangleOffset;

            int hitInstanceID = rayQueryGetIntersectionInstanceIdEXT(rayQuery, false);
            int materialOffset = bvhInstances[nonuniformEXT(hitInstanceID)].materialOffset;

            vec2 barrycentric = rayQueryGetIntersectionBarycentricsEXT(rayQuery, false);

            Triangle tri = UnpackTriangle(triangles[nonuniformEXT(meshIdx)].data[nonuniformEXT(hitID)]);
            transparency *= (1.0 - GetOpacity(tri, barrycentric, materialOffset, 0));

            if (transparency < 0.001) {
                rayQueryTerminateEXT(rayQuery);
                return 0.0;
            }

        }

    }

    if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        return 0.0;
    }

    return transparency;

}
#endif

// Non-opaque geometry is alpha tested with OPACITY_CHECK
void HitClosestOpacityCheck(inout Ray ray, uint cullMask, float tMin, float tMax) {

#ifdef OPACITY_CHECK
    HitClosestTransparency(ray, cullMask, tMin, tMax);
#else
    HitClosest(ray, cullMask, tMin, tMax);
#endif

}

// Rays of the ray buffer are traced in a separate pass by compute pipelines, ray tracing pipelines trace them here
void TraceBufferedRay(inout Ray ray) {

#ifdef RAY_TRACING_PIPELINE
    ray.hitID = -1;
    ray.hitDistance = 0.0;
    if (ray.ID >= 0)
        HitClosestOpacityCheck(ray, INSTANCE_MASK_ALL, 0.0, INF);
#endif

}
