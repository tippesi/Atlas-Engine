// Forward shading of translucent surfaces, included by the geometry fragment shader with TRANSLUCENT. One blend mode
// macro is set: BLEND_ALPHA (premultiplied), BLEND_ADDITIVE or BLEND_MULTIPLY. Refracting materials have REFRACTION

#define SHADOW_FILTER_VOGEL

#include <../deferred/deferred.hsh>
#include <../structures.hsh>
#include <../shadow.hsh>
#include <../common/light.hsh>
#include <../brdf/brdfEval.hsh>
#include <../clouds/shadow.hsh>
#include <../volumetric/froxelSlices.hsh>

#ifdef DDGI
#include <../ddgi/ddgi.hsh>
#endif

layout(set = 3, binding = 11) uniform sampler shadowSampler;
#ifdef CLOUD_SHADOWS
layout(set = 3, binding = 12) uniform sampler2D cloudMap;
#endif

#include <../deferred/directLight.hsh>

// Light tiles which reach from the near plane to the opaque surfaces, with the buckets of deferred/lightCulling.hsh
const int lightBucketCount = 128;

// Has to match TranslucentRenderer::maxRefractionDisplacement
#define REFRACTION_MAX_DISPLACEMENT 0.05

layout(std430, set = 3, binding = 13) readonly buffer TranslucentLightBuckets {
    int lightBuckets[];
};

layout(set = 3, binding = 14) uniform sampler2D refractionTexture;
layout(set = 3, binding = 15) uniform sampler2D refractionDepthTexture;
// The closest back faces of closed refracting surfaces and the instances they belong to
layout(set = 3, binding = 20) uniform sampler2D refractionBackDepthTexture;
layout(set = 3, binding = 21) uniform usampler2D refractionBackInstanceTexture;
#ifdef REFLECTION
// Traced from the closest alpha blended surface, see the front layer of the translucent renderer
layout(set = 3, binding = 16) uniform sampler2D reflectionTexture;
layout(set = 3, binding = 17) uniform sampler2D reflectionDepthTexture;
#endif
#ifdef FOG
layout(set = 3, binding = 18) uniform sampler3D integratedFroxelTexture;
#endif

layout(std140, set = 3, binding = 19) uniform TranslucentUniformBuffer {
    vec2 resolution;
    // Maps the unjittered screen coordinates to the froxel columns
    vec2 froxelGridScale;
    int lightBucketCount;
    int lightTileCountX;
    int specularProbeMipLevels;
    int refractionMipLevels;
    float froxelNear;
    float froxelFar;
    float froxelExtendedFar;
    int froxelSliceCount;
    float froxelDistributionExponent;
} translucentUniforms;

vec3 GetTranslucentDirectLight(Surface surface, vec3 geometryNormal, ivec2 pixel, vec2 texCoord) {

    ivec2 tile = pixel / ivec2(16);
    int bucketOffset = (tile.x + tile.y * translucentUniforms.lightTileCountX) * lightBucketCount;

    vec3 direct = vec3(0.0);
    for (int i = 0; i < translucentUniforms.lightBucketCount; i++) {
        uint lightBucket = uint(lightBuckets[bucketOffset + i]);
        if (lightBucket == 0u)
            continue;

        uint bucketBitCount = findMSB(lightBucket) + 1u;
        for (uint j = 0u; j < bucketBitCount; j++) {
            if ((lightBucket & (1u << j)) == 0u)
                continue;

            uint lightIdx = uint(i) * 32u + j;
            direct += EvaluateLight(lights[lightIdx], surface, geometryNormal, lightIdx == 0u, pixel, texCoord);
        }
    }
    return direct;

}

vec3 GetTranslucentIndirectDiffuse(Surface surface, vec3 geometryNormal) {

    vec3 worldView = -normalize(vec3(globalData.ivMatrix * vec4(surface.P, 0.0)));
    vec3 worldPosition = vec3(globalData.ivMatrix * vec4(surface.P, 1.0));
    vec3 worldNormal = normalize(vec3(globalData.ivMatrix * vec4(surface.N, 0.0)));
    vec3 geometryWorldNormal = normalize(vec3(globalData.ivMatrix * vec4(geometryNormal, 0.0)));

    vec3 prefilteredDiffuse = textureLod(diffuseProbe, worldNormal, 0).rgb;
#ifdef DDGI
#ifdef DDGI_SCROLL
    vec4 prefilteredDiffuseLocal = ddgiData.volumeEnabled > 0 ?
        GetLocalIrradiance(worldPosition, worldView, worldNormal, geometryWorldNormal, prefilteredDiffuse) : vec4(0.0, 0.0, 0.0, 1.0);
#else
    vec4 prefilteredDiffuseLocal = ddgiData.volumeEnabled > 0 ?
        GetLocalIrradiance(worldPosition, worldView, worldNormal, geometryWorldNormal) : vec4(0.0, 0.0, 0.0, 1.0);
#endif
    prefilteredDiffuseLocal = IsInsideVolume(worldPosition) ? prefilteredDiffuseLocal : vec4(0.0, 0.0, 0.0, 1.0);
    prefilteredDiffuse = (prefilteredDiffuseLocal.rgb + prefilteredDiffuse * prefilteredDiffuseLocal.a) * ddgiData.volumeStrength;
#endif
    return prefilteredDiffuse * EvaluateIndirectDiffuseBRDF(surface) * surface.material.ao;

}

vec3 GetTranslucentIndirectSpecular(Surface surface, vec2 texCoord) {

    vec3 R = normalize(mat3(globalData.ivMatrix) * reflect(-surface.V, surface.N));
    float mipLevel = surface.material.roughness * float(translucentUniforms.specularProbeMipLevels - 1);
    vec3 indirectSpecular = textureLod(specularProbe, R, mipLevel).rgb;

#ifdef REFLECTION
    // Only the closest alpha blended surface has traced reflections, the ones behind it use the probe
    float reflectionDepth = textureLod(reflectionDepthTexture, texCoord, 0.0).r;
    float reflectionViewDepth = ConvertDepthToViewSpace(reflectionDepth, texCoord).z;
    if (abs(reflectionViewDepth - surface.P.z) < 0.01 * abs(surface.P.z))
        indirectSpecular = textureLod(reflectionTexture, texCoord, 0.0).rgb;
#endif

    return indirectSpecular * EvaluateIndirectSpecularBRDF(surface) * surface.material.ao;

}

// The in-scattered light (rgb) and transmittance (a) between the camera and the surface
vec4 GetTranslucentFog(vec3 viewPosition, vec2 texCoord) {

#ifdef FOG
    FroxelSlices slices = FroxelSlices(translucentUniforms.froxelNear, translucentUniforms.froxelFar,
        translucentUniforms.froxelExtendedFar, translucentUniforms.froxelSliceCount, translucentUniforms.froxelDistributionExponent);

    // Each slice stores the integral up to its far end, inside the first slice it is interpolated from the camera
    float slice = GetFroxelSlice(slices, -viewPosition.z);
    vec2 unjitteredTexCoord = texCoord - 0.5 * globalData.jitterCurrent;
    vec2 gridTexCoord = unjitteredTexCoord * translucentUniforms.froxelGridScale;
    float sliceTexCoord = (max(slice - 1.0, 0.0) + 0.5) / float(translucentUniforms.froxelSliceCount);
    vec4 integrated = textureLod(integratedFroxelTexture, vec3(gridTexCoord, sliceTexCoord), 0.0);
    return mix(vec4(0.0, 0.0, 0.0, 1.0), integrated, clamp(slice, 0.0, 1.0));
#else
    return vec4(0.0, 0.0, 0.0, 1.0);
#endif

}

vec2 ProjectToTexCoord(vec3 viewPosition) {

    vec4 projected = globalData.pMatrix * vec4(viewPosition, 1.0);
    return projected.xy / projected.w * 0.5 + 0.5;

}

// The angle of the cone rough surfaces scatter refracted rays into. A microfacet tilted by an angle only turns the ray by
// the fraction 1 - 1 / n of it, at both sides of the surface
float GetRefractionSpread(float roughness, float refractiveIndex) {

    return 2.0 * sqr(roughness) * abs(1.0 - 1.0 / refractiveIndex);

}

// The mip of the background which blurs it like the cone of the refracted rays where they reach it, far from the surface
// the blur is larger
float GetRefractionMipLevel(float spread, vec3 surfacePosition, vec2 backgroundTexCoord) {

    vec3 position = ConvertDepthToViewSpace(textureLod(refractionDepthTexture, backgroundTexCoord, 0.0).r, backgroundTexCoord);
    float radius = spread * distance(position, surfacePosition);
    float pixels = radius * abs(globalData.pMatrix[1][1]) * float(textureSize(refractionTexture, 0).y) / max(-position.z, 0.001);
    return clamp(log2(max(pixels, 1.0)), 0.0, float(translucentUniforms.refractionMipLevels - 1));

}

// How far surfaces displace the background relative to their thickness. A sphere which displaces it by half of its thickness
// or more turns it around in its center, the strength stays well below for any refractive index
float GetDisplacementStrength(float refractiveIndex) {

    const float maxStrength = 0.35;
    return maxStrength * tanh((refractiveIndex - 1.0) / maxStrength);

}

// The background seen through the surface, displaced by the normal, more with the refraction and the distance the light
// travels inside
vec3 GetRefractedBackground(Surface surface, vec2 texCoord, float refractiveIndex, float thickness) {

    // Closed surfaces are as thick as the distance to their own back faces, the closest ones can belong to another object
    float backDepth = textureLod(refractionBackDepthTexture, texCoord, 0.0).r;
    uint backInstance = texelFetch(refractionBackInstanceTexture, ivec2(gl_FragCoord.xy), 0).r;
    if (backInstance == GetRefractionInstance(PushConstants.instanceOffset) && ConvertDepthToViewSpaceDepth(backDepth) < surface.P.z)
        thickness = distance(ConvertDepthToViewSpace(backDepth, texCoord), surface.P);

    vec3 offsetPosition = surface.P - vec3(surface.N.xy * GetDisplacementStrength(refractiveIndex) * thickness, 0.0);
    vec2 offset = ProjectToTexCoord(offsetPosition) - texCoord;

    // The background stays close to the surface, the limit is relative to the height of the image. Toward the edges of the
    // screen there is nothing to displace into, the background continues to them
    float aspectRatio = translucentUniforms.resolution.x / translucentUniforms.resolution.y;
    float displacement = max(length(offset * vec2(aspectRatio, 1.0)), 1e-6);
    offset *= REFRACTION_MAX_DISPLACEMENT * tanh(displacement / REFRACTION_MAX_DISPLACEMENT) / displacement;
    offset *= EdgeFadeOut(texCoord, 0.1);

    // Surfaces in front of this one stay in front, they would bleed into it
    vec2 offsetTexCoord = clamp(texCoord + offset, vec2(0.0), vec2(1.0));
    float backgroundViewDepth = ConvertDepthToViewSpaceDepth(textureLod(refractionDepthTexture, offsetTexCoord, 0.0).r);
    vec2 backgroundTexCoord = backgroundViewDepth < surface.P.z ? offsetTexCoord : texCoord;

    float spread = GetRefractionSpread(surface.material.roughness, refractiveIndex);
    float mipLevel = GetRefractionMipLevel(spread, surface.P, backgroundTexCoord);
    vec3 absorption = GetAbsorption(surface.material.attenuationColor, surface.material.attenuationDistance, thickness);
    return absorption * textureLod(refractionTexture, backgroundTexCoord, mipLevel).rgb;

}

// The color to blend for the material at the view space position with the opacity as coverage. The blend state of the
// mode combines it with the background, the coverage is written for the reactive mask
vec4 ShadeTranslucent(Material material, vec3 normal, vec3 geometryNormal, vec3 viewPosition, float opacity,
    float refractiveIndex, float thickness, out float coverage) {

    ivec2 pixel = ivec2(gl_FragCoord.xy);
    vec2 texCoord = gl_FragCoord.xy / translucentUniforms.resolution;
    vec4 fog = GetTranslucentFog(viewPosition, texCoord);

#ifdef BLEND_MULTIPLY
    // Darkens the background by the color, the fog in front of the surface isn't darkened
    coverage = 1.0;
    vec3 factor = mix(vec3(1.0), material.baseColor, opacity);
    return vec4(mix(vec3(1.0), factor, fog.a), 1.0);
#else
    Surface surface = CreateSurface(normalize(-viewPosition), normal, vec3(0.0, -1.0, 0.0), material);
    surface.P = viewPosition;
#ifdef BLEND_ADDITIVE
    surface.material.opacity = 1.0;
#else
    // The direct light weights the diffuse part by it
    surface.material.opacity = opacity;
#endif

    vec3 direct = GetTranslucentDirectLight(surface, geometryNormal, pixel, texCoord);
    vec3 indirectDiffuse = GetTranslucentIndirectDiffuse(surface, geometryNormal);
    vec3 specular = GetTranslucentIndirectSpecular(surface, texCoord);
    vec3 emissive = material.emissiveColor * globalData.preExposure;

    coverage = opacity;
#ifdef BLEND_ADDITIVE
    // Adds light only, the fog in front of the surface is already in the background
    vec3 color = (direct + indirectDiffuse + specular + emissive) * opacity;
    return vec4(color * fog.a, 0.0);
#else
    // Reflections and emission keep their strength on clear surfaces. What the surface reflects doesn't pass it, the
    // background is dimmed by the reflected part of the light like in the path tracer
    vec3 transmittance = (1.0 - opacity) * (1.0 - EvaluateIndirectSpecularBRDF(surface));
    float alpha = 1.0 - dot(transmittance, vec3(1.0 / 3.0));
    vec3 color = direct + indirectDiffuse * opacity + specular + emissive;
    color = color * fog.a + fog.rgb * alpha;
#ifndef REFRACTION
    return vec4(color, alpha);
#else
    // The refracted background replaces the one behind the surface
    vec3 background = GetRefractedBackground(surface, texCoord, refractiveIndex, thickness);
    return vec4(color + background * transmittance, 1.0);
#endif
#endif
#endif

}
