#include <sharedUniforms.hsh>

#include <../common/utility.hsh>
#include <../common/random.hsh>

layout(set = 3, binding = 9) uniform sampler2D terrainHeight;

float ShoreValueNoise(vec2 position) {

    ivec2 cell = ivec2(floor(position));
    vec2 weight = fract(position);
    weight = weight * weight * (3.0 - 2.0 * weight);

    float a = floatConstruct(hash(uvec2(cell)));
    float b = floatConstruct(hash(uvec2(cell + ivec2(1, 0))));
    float c = floatConstruct(hash(uvec2(cell + ivec2(0, 1))));
    float d = floatConstruct(hash(uvec2(cell + ivec2(1, 1))));
    return mix(mix(a, b, weight.x), mix(c, d, weight.x), weight.y);

}

// Breaks the shore waves into irregular stretches that drift slowly, independent of the world axes
float ShoreModulation(vec3 position) {

    vec2 drift = vec2(0.031, 0.017) * globalData.time;
    float noise = 0.65 * ShoreValueNoise(position.xz / 28.0 + drift) + 0.35 * ShoreValueNoise(position.xz / 9.0 - 1.7 * drift);
    return smoothstep(0.45, 0.75, noise);

}

// Scale fades the shore wave out on the shore and in deep water
float GetShoreWavePhase(vec3 position, out float scale, out vec2 shoreGradient) {

    vec2 terrainTex = (position.xz - Uniforms.terrainTranslation.xz) / Uniforms.terrainSideLength;
    vec4 shore = textureLod(terrainHeight, terrainTex, 0.0);

    float shoreDistance = shore.g;
    shoreGradient = normalize(2.0 * shore.ba - 1.0);

    // Avoid scaling by water depth. Resolution artifacts become obvious.
    scale = saturate(1.0 - shoreDistance) * saturate(shoreDistance * 10.0);

    float waveLength = Uniforms.shoreWaveLength / 100.0;
    float speed = Uniforms.shoreWaveSpeed / 100.0;
    return (shoreDistance + speed * globalData.time) / waveLength;

}

vec3 CalculateGerstner(vec3 position) {

    float scale;
    vec2 shoreGradient;
    float rad = GetShoreWavePhase(position, scale, shoreGradient);

    float distanceScale = saturate(1.0 - (distance(globalData.cameraLocation.xyz, position)
         - Uniforms.shoreWaveDistanceOffset) / Uniforms.shoreWaveDistanceScale);
    if (scale * distanceScale <= 0.0)
        return vec3(0.0);

    float modulation = ShoreModulation(position);

    float amplitude = 1.0 * Uniforms.shoreWaveAmplitude * scale * modulation * distanceScale;
    float steepness = 1.0 * Uniforms.shoreWaveSteepness * scale * modulation * distanceScale;

    vec3 offset;

    float gamma = Uniforms.shoreWavePower;
    offset.y = amplitude * pow(0.5 * sin(rad) + 0.5, gamma);
    offset.xz = -shoreGradient * steepness * amplitude * pow(0.5 * cos(rad) + 0.5, gamma);

    return offset;

}

vec2 CalculateShoreInteraction(vec3 position) {

    float scale;
    vec2 shoreGradient;
    float rad = GetShoreWavePhase(position, scale, shoreGradient);
    if (scale <= 0.3)
        return vec2(0.0);

    float modulation = ShoreModulation(position);

    // Move these calculations to the fragment shader
    float foamShoreWave = max(-cos(rad), 0.0) * 1.0 * max(scale - 0.3, 0.0) * modulation;
    float breakingShoreWave = saturate(max(sin(rad - 0.7), 0.0) * 4.0 * max(scale - 0.3, 0.0)) * modulation;

    return vec2(saturate(foamShoreWave), breakingShoreWave);

}