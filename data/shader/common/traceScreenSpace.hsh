// Some ideas: https://willpgfx.com/2015/07/screen-space-glossy-reflections/
// More: https://interplayoflight.wordpress.com/2019/09/07/hybrid-screen-space-reflections/

#include <convert.hsh>
#include <../globals.hsh>

#define point2 vec2
#define point3 vec3

// Returns true if the ray hit something, the hierarchical depth buffer is generated by the HiZRenderer
bool traceScreenSpaceHiZ(point3 csOrig, vec3 csDir, sampler2D hiZTexture, int hiZLevelCount, vec2 depthBufferSize,
    int maxIterations, float maxDistance, bool stopBehindGeometry, out point2 hitPixel, out point3 hitPoint) {

    hitPixel = vec2(0.0);
    hitPoint = vec3(0.0);

    // Clip to the near plane
    float rayLength = ((csOrig.z + csDir.z * maxDistance) > -globalData.cameraNearPlane) ?
        (-globalData.cameraNearPlane - csOrig.z) / csDir.z : maxDistance;
    point3 csEndPoint = csOrig + csDir * rayLength;

    vec4 H0 = globalData.pMatrix * vec4(csOrig, 1.0);
    vec4 H1 = globalData.pMatrix * vec4(csEndPoint, 1.0);
    vec3 S0 = vec3((H0.xy / H0.w * 0.5 + 0.5) * depthBufferSize, H0.z / H0.w);
    vec3 S1 = vec3((H1.xy / H1.w * 0.5 + 0.5) * depthBufferSize, H1.z / H1.w);
    vec3 D = S1 - S0;

    vec2 safeD = mix(D.xy, vec2(1e-12), lessThan(abs(D.xy), vec2(1e-12)));
    vec2 invD = 1.0 / safeD;

    vec2 tBorder = (mix(vec2(0.0), depthBufferSize, greaterThan(D.xy, vec2(0.0))) - S0.xy) * invD;
    float tEnd = min(1.0, min(tBorder.x, tBorder.y));

    float pixelLength = max(abs(D.x), abs(D.y));
    float tEpsilon = 0.01 / max(pixelLength, 1.0);

    vec2 stepDirection = vec2(greaterThan(D.xy, vec2(0.0)));

    // Skipping more than the origin pixel might miss surfaces next to the origin
    vec2 tOriginExit = ((floor(S0.xy) + stepDirection) - S0.xy) * invD;
    float t = min(min(tOriginExit.x, tOriginExit.y) + tEpsilon, 1.0);

    int level = 0;
    for (int i = 0; i < maxIterations && t < tEnd; i++) {
        point2 P = S0.xy + D.xy * t;
        float cellSize = float(1 << level);
        vec2 cell = floor(P / cellSize);
        vec2 minMaxDepth = texelFetch(hiZTexture, ivec2(cell), level).rg;

        vec2 tBoundary = ((cell + stepDirection) * cellSize - S0.xy) * invD;
        float tExit = min(min(tBoundary.x, tBoundary.y), tEnd);
        float rayDepth0 = S0.z + D.z * t;
        float rayDepth1 = S0.z + D.z * tExit;
        float rayDepthMin = min(rayDepth0, rayDepth1);
        float rayDepthMax = max(rayDepth0, rayDepth1);

        bool inFront = rayDepthMax < minMaxDepth.x;
        bool behind = rayDepthMin > minMaxDepth.y;

        if (stopBehindGeometry && behind)
            return false;

        if (inFront || behind) {
            t = tExit + tEpsilon;
            level = min(level + 1, hiZLevelCount - 1);
        }
        else if (level > 0) {
            level--;
        }
        else {
            if (minMaxDepth.x >= 1.0) {
                t = tExit + tEpsilon;
                continue;
            }

            hitPixel = cell;
            vec2 texCoord = (cell + 0.5) / depthBufferSize;
            hitPoint = ConvertDepthToViewSpace(rayDepth0, texCoord);
            return true;
        }
    }

    return false;

}
