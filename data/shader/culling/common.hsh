// Has to match the structures in scene/GPUScene.h

#define INSTANCE_VISIBLE 1u
#define INSTANCE_DONT_CULL 2u
#define INSTANCE_REVERSED_WINDING 4u

#define INVALID_HISTORY_IDX 0xFFFFFFFFu

#define MESH_DRAWABLE 1u
#define MESH_CAST_SHADOW 2u
#define MESH_IMPOSTOR 4u
#define MESH_GEOMETRY 8u
#define MESH_DRAW_EARLY 16u

// Has to match MeshData::maxLodCount
#define MAX_LOD_COUNT 5u

#define DRAW_DEFAULT_WINDING 0u
#define DRAW_REVERSED_WINDING 1u
#define DRAW_IMPOSTOR 2u

// Each view has a counter per winding and level of detail of a mesh, the one of the impostors comes after them
#define IMPOSTOR_COUNTER (2u * MAX_LOD_COUNT)
#define MESH_COUNTER_COUNT (2u * MAX_LOD_COUNT + 1u)

struct Instance {
    // Rows of the global matrix
    mat3x4 matrix;
    uint meshIdx;
    uint flags;
    uint historyIdx;
    // Whether the main view saw the instance in its last occlusion test
    uint visibleLastFrame;
};

struct CullMesh {
    // The w components are the distance culling of the main and the shadow passes
    vec4 aabbMin;
    vec4 aabbMax;
    float impostorDistance;
    float impostorShadowDistance;
    uint flags;
    // Instances with a smaller bounding sphere in pixels are culled
    float minScreenSize;
    // Each level of detail has a region of this capacity
    uint regionOffset;
    uint regionCapacity;
    uint impostorRegionOffset;
    uint lodCount;
    // Errors of the levels from 1 on divided by their pixel error, an instance uses a level while the error times its
    // scale and the focal length stays below its distance
    vec4 lodErrors;
};

uint SelectLod(CullMesh mesh, float distance, float scale, float focalLength) {

    uint lod = 0u;
    float projection = scale * focalLength;
    for (uint i = 1u; i < mesh.lodCount; i++) {
        if (mesh.lodErrors[i - 1u] * projection > distance)
            break;
        lod = i;
    }
    return lod;

}

float GetMaxScale(mat3x4 matrix) {

    return max(length(vec3(matrix[0].x, matrix[1].x, matrix[2].x)),
        max(length(vec3(matrix[0].y, matrix[1].y, matrix[2].y)), length(vec3(matrix[0].z, matrix[1].z, matrix[2].z))));

}

struct CullView {
    vec4 planes[6];
    uint shadow;
    uint indexOffset;
    uint impostorIndexOffset;
    uint counterOffset;
};

vec3 GetInstancePosition(mat3x4 matrix) {

    return vec3(matrix[0].w, matrix[1].w, matrix[2].w);

}
